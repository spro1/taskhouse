{
  "name": "taskhouse",
  "version": "0.1.0",
  "description": "Self-hosted lightweight issue tracker for small teams",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts & vite",
    "build": "vite build",
    "start": "node server/index.ts",
    "test": "tsx --test server/*.test.ts",
    "typecheck": "tsc",
    "audit": "npm audit",
    "dev:db": "tsx scripts/dev-db.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@hono/node-ws": "^1.3.2",
    "fractional-indexing": "^4.0.0",
    "hono": "^4.13.22",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@tiptap/extension-mention": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@tiptap/suggestion": "^3.35.0",
    "@types/node": "^26.6.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "embedded-postgres": "^17.12.0-beta.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
