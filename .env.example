# Copy to .env and set POSTGRES_PASSWORD (a long random string).
POSTGRES_PASSWORD=
# Public address, e.g. https://issues.example.com (links in webhooks, SSO redirect, secure cookies).
PUBLIC_URL=
PORT=3000
BIND_ADDRESS=0.0.0.0
# 1 when behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0
SESSION_HOURS=12
# Optional: fixed first-run token instead of the random one printed in the app log.
SETUP_TOKEN=

# Single sign-on (OpenID Connect). Redirect URI to register at the IdP: $PUBLIC_URL/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=SSO
OIDC_GROUPS_CLAIM=groups
# Members of this IdP group become site admins.
OIDC_ADMIN_GROUP=
# 0 = SSO only (the local break-glass admin can still sign in with a password).
PASSWORD_LOGIN=1
# API tokens of SSO accounts stop working when the person hasn't signed in for this many days.
TOKEN_SSO_GRACE_DAYS=30

# Notification email digests, e.g. smtp://user:pass@mail.example.com:587 (empty = off).
SMTP_URL=
SMTP_FROM=

# Webhooks never go to loopback or link-local addresses; hosts listed here are exempt (comma-separated).
WEBHOOK_ALLOW=

MAX_UPLOAD_MB=50
# Attachment storage limit in GB (0 = none). When reached, only new uploads are refused.
MAX_STORAGE_GB=0
AUDIT_KEEP_DAYS=365
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
