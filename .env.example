# Copy to .env and set POSTGRES_PASSWORD (a long random string).
POSTGRES_PASSWORD=
# Public address, e.g. https://issues.example.com (links in webhooks, SSO redirect, secure cookies).
PUBLIC_URL=
PORT=3000
BIND_ADDRESS=0.0.0.0
# Number of reverse proxies in front that set X-Forwarded-For (1 = one nginx); 0 = none. Used for sign-in limits and the audit log.
TRUST_PROXY=0
# How long a sign-in lasts, in hours (default 24). Changing it applies to new sign-ins.
SESSION_HOURS=24
# Optional: fixed first-run token instead of the random one printed in the app log.
SETUP_TOKEN=
# Encrypts secrets stored in the database (webhook signing keys, the SSO client secret) so a leaked dump or backup
# doesn't leak them. install.sh fills it in. Keep it: without it, encrypted secrets can't be read (webhooks then fail
# and SSO needs its client secret entered again). Not in the database or the backups, so back it up with .env.
SECRET_KEY=

# Single sign-on (OpenID Connect). Can also be set in Admin → SSO instead; these variables win when set.
# Redirect URI to register at the IdP: $PUBLIC_URL/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=SSO
OIDC_GROUPS_CLAIM=groups
# Members of this IdP group become site admins.
OIDC_ADMIN_GROUP=
# 0 = don't create accounts on first SSO sign-in (only people who already have one, or one with the same email, get in).
OIDC_AUTO_CREATE=1
# 1 = treat emails the IdP doesn't mark verified as verified when linking to an existing account with that email
# or creating a new account (both need a verified email).
# Only for IdPs that never send email_verified (some Entra ID setups), and only if users can't change their own email there.
OIDC_TRUST_EMAIL=0
# 0 = SSO only (the local break-glass admin can still sign in with a password).
PASSWORD_LOGIN=1
# API tokens of SSO accounts stop working when the person hasn't signed in for this many days.
TOKEN_SSO_GRACE_DAYS=30

# Notification email digests and "forgot password" links, e.g. smtp://user:pass@mail.example.com:587 (empty = off).
SMTP_URL=
SMTP_FROM=

# Webhooks never go to loopback or link-local addresses; hosts listed here are exempt (comma-separated).
WEBHOOK_ALLOW=

MAX_UPLOAD_MB=50
# Attachment storage limit in GB (0 = none). When reached, only new uploads are refused.
MAX_STORAGE_GB=0
AUDIT_KEEP_DAYS=365
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
# Prometheus: set a long random string to serve metrics at /metrics (scrapers send it as a bearer token). Empty = off.
METRICS_TOKEN=
